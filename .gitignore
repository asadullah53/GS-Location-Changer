# ---------------------------------------------------------------
# Chrome extension packaging artifacts
# ---------------------------------------------------------------
# NEVER commit these: Chrome generates a private key when you
# "Pack extension". Leaking it lets anyone publish updates as you.
*.pem
key.pem

# Packed / built output
*.crx
*.zip
*.xpi
dist/
build/
release/
web-ext-artifacts/

# Store credentials for automated uploads (chrome-webstore-upload etc.)
.env
.env.*
!.env.example
*.secret.json
client_secret*.json

# ---------------------------------------------------------------
# Node tooling (if you later add a bundler, linter or tests)
# ---------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
coverage/
.nyc_output/

# ---------------------------------------------------------------
# Editors & IDEs
# ---------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.sublime-workspace
*.sublime-project
*.code-workspace
*.swp
*.swo
*~

# ---------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
.directory
.Trash-*

# ---------------------------------------------------------------
# Local scratch — keep work-in-progress out of the repo
# ---------------------------------------------------------------
*.log
*.bak
*.tmp
tmp/
temp/
scratch/
notes.local.md
TODO.local.md
