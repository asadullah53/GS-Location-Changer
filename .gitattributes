# Normalize line endings so Windows/macOS/Linux contributors don't
# produce whole-file diffs. Text files are stored as LF in the repo
# and checked out with the platform's native endings.
* text=auto

*.js    text eol=lf
*.json  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf

# Binary assets — never touch these
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.zip   binary
*.crx   binary
